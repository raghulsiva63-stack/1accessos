{
  "manifest_version": 3,
  "name": "Passkey-X",
  "version": "0.5.0",
  "minimum_chrome_version": "127",
  "description": "Automatic save prompts and explicit, encrypted login fill for your Passkey-X vault.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Passkey-X",
    "default_icon": {
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "commands": {
    "fill-login": {
      "suggested_key": {
        "default": "Alt+Shift+X",
        "mac": "Alt+Shift+X"
      },
      "description": "Fill the first matching Passkey-X login"
    }
  },
  "host_permissions": [
    "https://passkey-x.com/*",
    "https://wkkmyacbhqloubtwvjom.supabase.co/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://passkey-x.com/*"
    ]
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'"
  }
}
