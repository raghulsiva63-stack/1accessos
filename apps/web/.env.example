NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_PASSKEYS_ENABLED=false
NEXT_PUBLIC_PHONE_MFA_ENABLED=false
NEXT_PUBLIC_BILLING_ENABLED=false

# Server-side Supabase Edge Function configuration uses four recurring Stripe
# Prices for each paid plan (month/year x INR/USD). Business therefore adds:
# STRIPE_PRICE_BUSINESS_MONTH_INR
# STRIPE_PRICE_BUSINESS_MONTH_USD
# STRIPE_PRICE_BUSINESS_YEAR_INR
# STRIPE_PRICE_BUSINESS_YEAR_USD

# Phone MFA is exposed only after the Supabase Send SMS Hook points at the
# sent-sms-hook Edge Function and the function has server-side secrets for:
# SEND_SMS_HOOK_SECRET, SENT_DM_API_KEY, and SENT_DM_SMS_SANDBOX.
# The connected ChatGPT Sent plugin is not a runtime credential for the app.
