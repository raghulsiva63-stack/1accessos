{
  "name": "passkey-x",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "test": "node --test packages/*/test/*.test.mjs",
    "test:crypto": "node --test packages/crypto/test/*.test.mjs",
    "test:api": "node --test packages/api-client/test/*.test.mjs",
    "test:extension": "npm --prefix apps/extension test",
    "test:cli": "npm --prefix apps/cli test",
    "build:extension": "npm --prefix apps/extension run build",
    "check:phase1": "node scripts/check-phase1.mjs",
    "check:phase2": "node scripts/check-phase2.mjs",
    "check:phase3": "node scripts/check-phase3.mjs",
    "check:phase4": "node scripts/check-phase4.mjs",
    "check:phase5": "node scripts/check-phase5.mjs",
    "check:phase6": "node scripts/check-phase6.mjs",
    "check": "node --check packages/crypto/src/index.mjs && node scripts/check-phase0.mjs && node scripts/check-phase1.mjs && node scripts/check-phase2.mjs && node scripts/check-phase3.mjs && node scripts/check-phase4.mjs && node scripts/check-phase5.mjs && node scripts/check-phase6.mjs && node scripts/check-auth-communications.mjs && npm test && npm run test:cli && npm run test:auth",
    "test:auth": "node --test tests/auth/*.test.mjs"
  },
  "workspaces": [
    "packages/*"
  ]
}
